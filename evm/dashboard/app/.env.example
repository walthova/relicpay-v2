# Server-side only. No NEXT_PUBLIC_ prefix: that prefix inlines a value into the client bundle, and
# a keyed RPC endpoint inlined into the bundle is handed to every visitor. dashboard/lib/client.js
# refuses NEXT_PUBLIC_RPC_URL and there is a test asserting it does.
RPC_URL=https://sepolia.example/v3/your-key

# Which chain the address book and the viem client are for. sepolia, mainnet, base, base-sepolia,
# local.
NETWORK=sepolia

# The block DeployAll.s.sol landed in. Agreement discovery is an eth_getLogs scan for
# AgreementCreated starting here; leaving it at 0 scans the whole chain for a handful of agreements.
DEPLOY_BLOCK=0

# Addresses. Normally read from deployments/<network>.txt, which DeployAll writes. These override
# it. Addresses are public, so the NEXT_PUBLIC_ forms are accepted for these; see
# dashboard/lib/addresses.js.
# NEXT_PUBLIC_RELICPAY_ADDRESS=0x...
# NEXT_PUBLIC_RELIC_REGISTRY_ADDRESS=0x...
