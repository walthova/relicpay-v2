# Relic Pay — environment variables
# Copy this file to .env.local and fill in your values

# Required: Anthropic API key for the Claude Guide feature
# Get yours at console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Required: merchant payout wallet — checkout fails without it
NEXT_PUBLIC_MERCHANT_WALLET=

# Optional: override the deployed program / USDC mint for another cluster
# NEXT_PUBLIC_PROGRAM_ID=5GPVYpyzdosbzWcdttcCdziJVqUCCARf98J857C3T6Gi
# NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
